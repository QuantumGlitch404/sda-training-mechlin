NODE_ENV=staging
PORT=3015
API_BASE_URL=https://staging-api.example.com/api/v1

MONGODB_URI=mongodb+srv://staging-user:password@example.mongodb.net/sda-training
POSTGRES_URL=postgresql://staging-user:password@staging-db.example.com:5432/sda_training
REDIS_URL=rediss://staging-redis.example.com:6379

JWT_SECRET=replace-with-secure-staging-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
LOG_LEVEL=info