NODE_ENV=production
PORT=3015
API_BASE_URL=https://api.example.com/api/v1

MONGODB_URI=mongodb+srv://production-user:password@example.mongodb.net/sda-training
POSTGRES_URL=postgresql://production-user:password@production-db.example.com:5432/sda_training
REDIS_URL=rediss://production-redis.example.com:6379

JWT_SECRET=replace-with-secure-production-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
LOG_LEVEL=warn