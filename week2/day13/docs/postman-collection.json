{
  "info": {
    "name": "SDA Training API",
    "description": "API collection for SDA Training program",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3013/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "demo-token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get all users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": 1,
              "description": "Page number"
            },
            {
              "key": "limit",
              "value": 10,
              "description": "Items per page"
            },
            {
              "key": "role",
              "value": "",
              "description": "Filter by role"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/{id}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{id}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/{id}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{id}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/{id}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{id}"
          ]
        }
      },
      "response": []
    }
  ]
}